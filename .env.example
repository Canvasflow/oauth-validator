# OAuth PKCE Validator — IdP Configuration
# Copy this file to .env.local and fill in your IdP values.
# .env.local is listed in .gitignore and must never be committed.
#
# VITE_ prefix exposes values to the client bundle at build time (vinxi/Vite).
# For Cloudflare Pages, add production values via: wrangler pages secret put <NAME>
# ──────────────────────────────────────────────────────────────────

# The IdP's issuer URL (the "iss" claim in tokens)
VITE_OAUTH_ISSUER=https://dev-t2i6s7aacr4c35y8.us.auth0.com

# The IdP's authorization endpoint
VITE_OAUTH_AUTHORIZATION_ENDPOINT=https://dev-t2i6s7aacr4c35y8.us.auth0.com/authorize

# The IdP's token endpoint (where the auth code is exchanged for tokens)
VITE_OAUTH_TOKEN_ENDPOINT=https://dev-t2i6s7aacr4c35y8.us.auth0.com/oauth/token

# Your OAuth client ID (registered in the IdP as a public SPA client — no secret)
VITE_OAUTH_CLIENT_ID=MhbVNZvPSkAWQW6Knm1lFDRIfLcfHFRe

# The redirect URI registered in the IdP (must be an exact match)
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback

# Space-separated scopes to request
VITE_OAUTH_SCOPE=openid email profile

# Optional: audience parameter (required by some IdPs, e.g. Auth0, to set aud claim)
VITE_OAUTH_AUDIENCE=canvasflow-api

# ──────────────────────────────────────────────────────────────────
# Quick-start values for common IdPs:
#
# Okta:
#   VITE_OAUTH_AUTHORIZATION_ENDPOINT=https://<domain>/oauth2/default/v1/authorize
#   VITE_OAUTH_TOKEN_ENDPOINT=https://<domain>/oauth2/default/v1/token
#
# Auth0:
#   VITE_OAUTH_AUTHORIZATION_ENDPOINT=https://<tenant>.auth0.com/authorize
#   VITE_OAUTH_TOKEN_ENDPOINT=https://<tenant>.auth0.com/oauth/token
#   VITE_OAUTH_AUDIENCE=canvasflow-api
#
# AWS Cognito:
#   VITE_OAUTH_AUTHORIZATION_ENDPOINT=https://<domain>.auth.<region>.amazoncognito.com/oauth2/authorize
#   VITE_OAUTH_TOKEN_ENDPOINT=https://<domain>.auth.<region>.amazoncognito.com/oauth2/token
#
# Azure AD:
#   VITE_OAUTH_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize
#   VITE_OAUTH_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
